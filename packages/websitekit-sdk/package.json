{
  "name": "@websitekit/sdk",
  "version": "0.1.1",
  "description": "Issuance and settlement layer for tokenized page inventory \u2014 reads, writes and pricing for SlotSite.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vibecodermaxi/websitekit.git",
    "directory": "packages/websitekit-sdk"
  },
  "homepage": "https://websitekit.org",
  "bugs": {
    "url": "https://github.com/vibecodermaxi/websitekit/issues"
  },
  "keywords": [
    "ethereum",
    "erc721",
    "viem",
    "onchain",
    "tokenization",
    "harberger",
    "websitekit"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "prepack": "tsup",
    "prepublishOnly": "node ../../scripts/assert-pnpm-publish.mjs",
    "test": "vitest run --passWithNoTests",
    "lint": "tsc --noEmit && tsc -p tsconfig.scripts.json",
    "sync:abi": "node scripts/sync-abi.mjs"
  },
  "peerDependencies": {
    "viem": "^2"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "viem": "2.55.8"
  }
}
