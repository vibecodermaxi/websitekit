{
  "name": "create-websitekit",
  "version": "0.1.0",
  "description": "Scaffold a websitekit project \u2014 a page whose regions are individually owned and tradeable on chain.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vibecodermaxi/websitekit.git",
    "directory": "packages/create-websitekit"
  },
  "homepage": "https://websitekit.org",
  "bugs": {
    "url": "https://github.com/vibecodermaxi/websitekit/issues"
  },
  "keywords": [
