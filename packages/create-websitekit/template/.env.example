# The v2 protocol on Robinhood Chain testnet (46630). Both are OPTIONAL: `@websitekit/sdk` publishes
# them, and `pnpm deploy:site` falls back to the published addresses. Set them to pin a different
# deployment — most usefully a newer SlotReader, which is deliberately replaceable (§11.4).
WEBSITEKIT_FACTORY=
WEBSITEKIT_READER=

# Only needed for `pnpm deploy:site`. A funded testnet key — never a mainnet one, and never commit
# this file. `pnpm dev` needs none of this: with nothing set, the page renders the shared demo board
# read-only, which is the zero-credential first run.
DEPLOYER_PRIVATE_KEY=

# Both written for you by `pnpm deploy:site`. Until then the page reads the shared demo board.
NEXT_PUBLIC_WEBSITEKIT_SITE=
NEXT_PUBLIC_WEBSITEKIT_READER=
