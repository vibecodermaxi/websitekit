# Which network. Unset means Robinhood Chain MAINNET (4663), where the money is real. Set 46630 for
# the testnet, where boards settle in a stand-in dollar anybody can mint. An id the SDK does not
# recognise stops the app rather than falling back to either.
NEXT_PUBLIC_WEBSITEKIT_CHAIN_ID=

# The protocol addresses. Both OPTIONAL: `@websitekit/sdk` publishes them for each chain, and
# `pnpm deploy:site` falls back to those. Set them to pin a different deployment — most usefully a
# newer SlotReader, which is deliberately replaceable (§11.4).
WEBSITEKIT_FACTORY=
WEBSITEKIT_READER=

# Only needed for `pnpm deploy:site`, and never commit this file. On mainnet it pays real gas, so
# use a key that holds only what a deploy needs. `pnpm dev` needs none of this: with nothing set,
# the page renders the shared demo board read-only, which is the zero-credential first run.
DEPLOYER_PRIVATE_KEY=

# Both written for you by `pnpm deploy:site`. Until then the page reads the shared demo board.
NEXT_PUBLIC_WEBSITEKIT_SITE=
NEXT_PUBLIC_WEBSITEKIT_READER=
